{
  "name": "resonant-mind",
  "version": "4.0.0",
  "private": true,
  "description": "A Postgres-backed cognitive substrate for persistent AI memory, identity, dreams, drives, and relational continuity",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres-v4.integration.test.ts",
    "test:registry": "vitest run tests/registry.test.ts",
    "scan:release": "node scripts/scan-release.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "verify": "npm run typecheck && npm test && npm run scan:release && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@google/genai": "2.11.0",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "@protobufjs/utf8": "1.1.2"
  }
}
